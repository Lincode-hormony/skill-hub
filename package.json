{
  "name": "skill-hub",
  "version": "1.0.0",
  "description": "通过统一存储与目录链接管理 Codex 和 Claude Code Skills",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test": "npm run test:scan-installed && npm run test:uninstall",
    "test:scan-installed": "node tests/scan-installed.integration.js",
    "test:uninstall": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File tests/install-uninstall.integration.ps1"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "skills",
    "claude-code",
    "codex",
    "ai",
    "agents"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "express": "^4.18.2",
    "cors": "^2.8.5"
  },
  "devDependencies": {
    "nodemon": "^3.0.1"
  }
}
